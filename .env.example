# Required by SEC EDGAR. Use a real contact string.
SEC_USER_AGENT=StockMarketBot your_email@example.com

# Optional Reddit API credentials. Strongly recommended if public Reddit JSON returns 403/429.
REDDIT_CLIENT_ID=optional_reddit_id
REDDIT_CLIENT_SECRET=optional_reddit_secret

# Optional Discord bot settings.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
REPORT_CHANNEL_ID=

# Optional NewsAPI key for future integrations.
NEWS_API_KEY=
