# Required by SEC EDGAR. Use a real contact string.
SEC_USER_AGENT=StockMarketBot your_email@example.com

# Optional Reddit API credentials. Strongly recommended if public Reddit JSON returns 403/429.
REDDIT_CLIENT_ID=optional_reddit_id
REDDIT_CLIENT_SECRET=optional_reddit_secret

# Optional Discord bot surface. DISCORD_GUILD_ID is required whenever a token
# is configured; DMs and other guilds are rejected before collectors run.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
REPORT_CHANNEL_ID=
DISCORD_REQUEST_COOLDOWN_SECONDS=30
DISCORD_MAX_TRACKED_USERS=2048
DISCORD_MAX_HISTORY_CHANNELS=100
DISCORD_HISTORY_ENTRIES_PER_CHANNEL=20

# Optional licensed headline providers. Missing keys skip the adapter without
# failing the brief. Official feeds, GDELT, and Google fallback are keyless.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Headline discovery/fallback controls.
HEADLINE_GDELT_ENABLED=true
HEADLINE_GOOGLE_FALLBACK_ENABLED=true

# Append-only brief archive. The canonical copy is project-local by default.
# Set an independent mirror path only when wanted on the deployment machine.
BRIEF_ARCHIVE_DIR=archive/briefs
BRIEF_ARCHIVE_MIRROR_DIR=
