                          }
                        },
                        "population_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "definition": {
                          "$ref": "#/$defs/atom"
                        },
                        "denominator_kind": {
                          "type": "object",
                          "additionalProperties": false,
