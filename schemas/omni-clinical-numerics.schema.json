{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omni-clinical-numerics-1-and-2",
  "title": "OMNI explicitly scoped clinical numeric result (AI draft)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "enum": [
        "omni-clinical-numerics-1",
        "omni-clinical-numerics-2"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "human_review_status": {
      "const": "pending"
    },
    "signal_eligible": {
      "const": false
    },
    "support": {
      "$ref": "#/$defs/support"
    },
    "missing_requirements": {
      "type": "array",
      "maxItems": 0
    },
    "analysis_scope_id": {
      "type": "string",
      "pattern": "^analysis:[a-f0-9]{64}$"
    },
    "result_id": {
      "type": "string",
      "pattern": "^numeric:[a-f0-9]{64}$"
    },
    "scope_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "trial_id",
        "version_revision",
        "source_native_id",
        "phase",
        "valid_from",
        "valid_to",
        "catalog_fingerprint",
        "review_input_hash",
        "human_review_status",
        "signal_eligible",
        "evidence_sources",
        "disclosure_time",
        "bindings"
      ],
      "properties": {
        "contract": {
          "const": "omni-clinical-scope-binding-1"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^trial:NCT[0-9]{8}$"
        },
        "version_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_native_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/$defs/atom"
