            "properties": {
              "name": {
                "enum": [
                  "trial",
                  "phase",
                  "endpoint",
                  "rank",
                  "population",
                  "cohort",
                  "treatment",
                  "comparator",
                  "timepoint",
                  "analysis",
                  "multiplicity",
                  "statistics"
