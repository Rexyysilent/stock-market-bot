        "row": {
          "$ref": "#/$defs/support"
        },
        "columns": {
          "type": "array",
          "minItems": 8,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "header",
              "cell"
