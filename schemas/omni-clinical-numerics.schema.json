              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "revision_id": {
                "type": "string",
                "minLength": 1
              },
              "native_id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "source_policy_id": {
                "type": "string",
                "minLength": 1
              },
              "source_policy_fingerprint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "disclosure_time": {
          "type": "object",
          "additionalProperties": false,
