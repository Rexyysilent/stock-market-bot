        "catalog_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "human_review_status": {
