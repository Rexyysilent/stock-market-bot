                  "$ref": "#/$defs/atom"
                }
              },
              "required": [
                "value",
                "operator",
                "sidedness",
                "adjustment"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "absolute_counts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "arm_role": {
                "$ref": "#/$defs/atom"
              },
              "measure": {
                "$ref": "#/$defs/atom"
              },
              "count": {
                "$ref": "#/$defs/atom"
              },
              "denominator": {
                "$ref": "#/$defs/atom"
              },
              "denominator_unit": {
