  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "const": "omni-clinical-numerics-1"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "scope_binding"
              ]
            },
            {
              "required": [
                "source_form"
              ]
            },
            {
              "required": [
                "table_proof"
              ]
            },
            {
              "properties": {
                "scope": {
                  "anyOf": [
                    {
                      "required": [
                        "cohort"
                      ]
                    },
                    {
                      "required": [
                        "multiplicity"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "statistics": {
                  "required": [
                    "effect_measure"
                  ]
                }
              }
            },
            {
              "properties": {
                "statistics": {
                  "properties": {
                    "p_value": {
                      "type": "object",
                      "required": [
                        "adjustment_method"
                      ]
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "statistics": {
                  "properties": {
                    "confidence_interval": {
                      "type": "object",
                      "required": [
                        "sidedness"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "source_form"
        ]
      },
      "then": {
        "required": [
          "table_proof"
        ]
      }
    },
    {
      "if": {
        "required": [
          "table_proof"
        ]
      },
      "then": {
        "required": [
          "source_form"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "statistics": {
            "required": [
              "effect_measure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "statistics": {
            "properties": {
              "hazard_ratio": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
