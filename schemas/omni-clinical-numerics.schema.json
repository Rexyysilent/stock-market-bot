              },
              "required": [
                "estimate",
                "unit"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_interval": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "level_percent": {
                  "$ref": "#/$defs/atom"
                },
                "lower": {
                  "$ref": "#/$defs/atom"
                },
                "upper": {
                  "$ref": "#/$defs/atom"
                },
                "unit": {
                  "$ref": "#/$defs/atom"
                },
                "sidedness": {
                  "$ref": "#/$defs/atom"
