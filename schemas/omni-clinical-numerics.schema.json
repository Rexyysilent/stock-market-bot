                  ],
                  "properties": {
                    "canonical_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_mention": {
                      "$ref": "#/$defs/support"
                    },
                    "definition": {
                      "type": "object",
                      "required": [
                        "label",
                        "aliases",
                        "arm_id",
                        "role"
                      ],
                      "properties": {
                        "label": {
                          "$ref": "#/$defs/atom"
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/atom"
                          }
                        },
                        "arm_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "value",
                            "support"
                          ],
                          "properties": {
                            "value": {
                              "enum": [
                                "treatment",
                                "comparator"
                              ]
                            },
                            "support": {
                              "$ref": "#/$defs/support"
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "cohort": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "canonical_id",
                    "source_mention",
                    "definition"
                  ],
                  "properties": {
                    "canonical_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_mention": {
                      "$ref": "#/$defs/support"
                    },
                    "definition": {
                      "type": "object",
                      "required": [
                        "label",
                        "aliases",
                        "cohort_id",
                        "definition"
                      ],
                      "properties": {
                        "label": {
                          "$ref": "#/$defs/atom"
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/atom"
                          }
                        },
                        "cohort_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "definition": {
                          "$ref": "#/$defs/atom"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "source_form": {
      "const": "complete_pipe_table_row"
    },
    "table_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "header",
        "row",
        "columns"
