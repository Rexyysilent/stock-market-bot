  "required": [
    "contract",
    "scope",
    "statistics",
    "human_review_status",
    "signal_eligible",
    "support",
    "missing_requirements",
    "analysis_scope_id",
    "result_id"
  ],
  "$defs": {
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "support"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "revision_id",
        "start",
        "end",
        "text"
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/atom"
        },
        "unit": {
          "$ref": "#/$defs/atom"
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trial_id": {
          "$ref": "#/$defs/atom"
        },
        "reported_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "indication": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "$ref": "#/$defs/atom"
        },
        "endpoint_rank": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis_population": {
          "$ref": "#/$defs/atom"
        },
        "treatment_arm": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_arm": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_cutoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "analysis_type": {
          "$ref": "#/$defs/atom"
        },
        "analysis_milestone": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "timepoint": {
          "$ref": "#/$defs/duration"
        },
        "follow_up": {
          "anyOf": [
            {
              "$ref": "#/$defs/duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "cohort": {
          "$ref": "#/$defs/atom"
        },
        "multiplicity": {
          "$ref": "#/$defs/atom"
        }
      },
      "required": [
        "trial_id",
        "reported_phase",
        "indication",
        "endpoint",
        "endpoint_rank",
        "analysis_population",
        "treatment_arm",
        "comparison_arm",
        "data_cutoff",
        "analysis_type",
        "analysis_milestone",
        "timepoint",
        "follow_up"
      ]
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hazard_ratio": {
          "anyOf": [
