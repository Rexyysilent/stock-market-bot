{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omni-clinical-scope-catalog-1",
  "title": "Optional reviewed evidence-backed clinical scope catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "trial_versions"
  ],
  "properties": {
    "contract": {
      "const": "omni-clinical-scope-catalog-1"
    },
    "trial_versions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "revision_id",
        "start",
        "end",
        "text"
      ]
    },
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "support"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "trial_id",
        "trial_identity",
        "phase",
        "valid_from",
        "valid_to",
        "source_native_id",
        "trial_aliases",
        "documents",
        "policies",
        "revision_id",
        "review",
        "endpoints",
        "arms",
        "populations",
        "cohorts"
      ],
      "properties": {
        "contract": {
          "const": "omni-clinical-scope-binding-1"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^trial:NCT[0-9]{8}$"
        },
        "trial_identity": {
          "$ref": "#/$defs/atom"
        },
        "phase": {
          "$ref": "#/$defs/atom"
        },
        "valid_from": {
          "$ref": "#/$defs/atom"
        },
        "valid_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/atom"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_native_id": {
          "type": "string",
          "minLength": 1
        },
        "trial_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/atom"
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "policies": {
          "type": "object"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review": {
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "enum": [
                "pending",
                "approve",
                "reject"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "reviewed_at": {
              "type": "string"
            },
            "input_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "aliases",
              "endpoint_id",
              "definition",
              "rank"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/atom"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/atom"
                }
              },
              "endpoint_id": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "$ref": "#/$defs/atom"
              },
              "rank": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "support"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "primary",
                      "secondary",
                      "exploratory"
                    ]
                  },
                  "support": {
                    "$ref": "#/$defs/support"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "aliases",
              "arm_id",
              "role"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/atom"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/atom"
                }
              },
              "arm_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "support"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "treatment",
                      "comparator"
                    ]
                  },
                  "support": {
                    "$ref": "#/$defs/support"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "populations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "aliases",
              "population_id",
              "definition",
              "denominator_kind"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/atom"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/atom"
                }
              },
              "population_id": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "$ref": "#/$defs/atom"
              },
              "denominator_kind": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "support"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "randomized",
                      "evaluable",
                      "treated",
                      "safety",
                      "other"
                    ]
                  },
                  "support": {
                    "$ref": "#/$defs/support"
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "cohorts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "label",
              "aliases",
              "cohort_id",
              "definition"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/atom"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/atom"
                }
              },
              "cohort_id": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "$ref": "#/$defs/atom"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
