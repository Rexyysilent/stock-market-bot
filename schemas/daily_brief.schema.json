{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stock-market-bot/daily_brief.schema.json",
  "title": "Stock Market Intelligence Daily Brief",
  "type": "object",
  "required": [
    "generated_at",
    "schema_version",
    "pipeline_version",
    "run_context",
    "pipeline_time_seconds",
    "health",
    "summary",
    "sections",
    "data_quality"
  ],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string", "const": "2.6"},
    "pipeline_version": {"type": "string", "enum": ["2.6.0", "2.6.1", "2.6.2", "2.6.3"]},
    "run_context": {
      "type": "object",
      "required": [
        "started_at",
        "utc_date",
        "market_state",
        "latest_completed_session"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "utc_date": {"type": "string", "format": "date"},
        "market_state": {"type": "string", "minLength": 1},
        "latest_completed_session": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "pipeline_time_seconds": {"type": "number", "minimum": 0},
    "health": {
      "type": "object",
      "required": ["status", "warnings", "errors", "sources"],
      "properties": {
        "status": {"enum": ["OK", "WARN", "ERROR"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "object"}
      },
      "additionalProperties": true
    },
    "summary": {"type": "object"},
    "sections": {
      "type": "object",
      "required": ["headlines"],
      "properties": {
        "headlines": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/headline"}
        }
      },
      "additionalProperties": true
    },
    "data_quality": {
      "type": "object",
      "required": ["headlines_dropped"],
      "properties": {
        "headline_contract_version": {
          "type": "string", "const": "2.6-headline-lanes-1"
        },
        "headlines_dropped": {"type": "array"},
        "headline_pool": {
          "type": "object",
          "required": [
            "fetched_count",
            "fresh_before_relevance"
          ],
          "properties": {
            "fetched_count": {"type": "integer", "minimum": 0},
            "fresh_before_relevance": {"type": "integer", "minimum": 0},
            "selected_count": {"type": "integer", "minimum": 0, "maximum": 5},
            "accounted_candidate_count": {"type": "integer", "minimum": 0},
            "selected_lane_counts": {
              "$ref": "#/$defs/laneCounts"
            }
          },
          "dependentRequired": {
            "accounted_candidate_count": ["selected_lane_counts"],
            "selected_lane_counts": ["accounted_candidate_count"]
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_quality": {
            "type": "object",
            "required": ["headline_contract_version"]
          }
        }
      },
      "then": {
        "properties": {
          "pipeline_version": {"enum": ["2.6.1", "2.6.2", "2.6.3"]},
          "sections": {
            "properties": {
              "headlines": {
                "items": {"$ref": "#/$defs/currentHeadline"}
              }
            }
          },
          "data_quality": {
            "required": ["headline_pool"],
            "properties": {
              "headlines_dropped": {
                "items": {"$ref": "#/$defs/currentDroppedHeadline"}
              },
              "headline_pool": {
                "required": [
                  "selected_count",
                  "accounted_candidate_count",
                  "selected_lane_counts"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "currentWebUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\\.([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*(:[0-9]{1,5})?(/([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|/)*)?([?]([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|[/?])*)?(#([A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2}|[/?])*)?$"
    },
    "currentDateTime": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "laneCounts": {
      "type": "object",
      "propertyNames": {
        "enum": ["universe", "macro", "discovery"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "scoreComponents": {
      "type": "object",
      "required": [
        "issuer_relevance",
        "macro_relevance",
        "vertical_relevance",
        "authority",
        "novelty",
        "impact"
      ],
      "properties": {
        "issuer_relevance": {"type": "integer", "minimum": 0},
        "macro_relevance": {"type": "integer", "minimum": 0},
        "vertical_relevance": {"type": "integer", "minimum": 0},
        "authority": {"type": "integer", "minimum": 0},
        "novelty": {"type": "integer", "minimum": 0},
        "impact": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "laneIntegrity": {
      "allOf": [
        {
          "if": {
            "properties": {"lane": {"const": "universe"}},
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "universe_tickers": {"minItems": 1},
              "score_components": {
                "properties": {
                  "issuer_relevance": {"minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"lane": {"const": "macro"}},
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "universe_tickers": {"maxItems": 0},
              "score_components": {
                "properties": {
                  "issuer_relevance": {"const": 0},
                  "macro_relevance": {"minimum": 1}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"lane": {"const": "discovery"}},
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "universe_tickers": {"maxItems": 0},
              "score_components": {
                "properties": {
                  "issuer_relevance": {"const": 0},
                  "macro_relevance": {"const": 0},
                  "impact": {"minimum": 2}
                },
                "anyOf": [
                  {
                    "properties": {
                      "vertical_relevance": {"minimum": 1}
                    }
                  },
                  {
                    "properties": {
                      "authority": {"minimum": 3}
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {"lane": {"const": null}},
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "reason": {"const": "no_approved_lane"},
              "universe_tickers": {"maxItems": 0},
              "score_components": {
                "properties": {
                  "issuer_relevance": {"const": 0},
                  "macro_relevance": {"const": 0}
                },
                "not": {
                  "allOf": [
                    {
                      "properties": {
                        "impact": {"minimum": 2}
                      }
                    },
                    {
                      "anyOf": [
                        {
                          "properties": {
                            "vertical_relevance": {"minimum": 1}
                          }
                        },
                        {
                          "properties": {
                            "authority": {"minimum": 3}
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {"const": "no_approved_lane"}
            },
            "required": ["reason"]
          },
          "then": {
            "properties": {
              "lane": {"const": null}
            }
          }
        }
      ]
    },
    "currentHeadline": {
      "type": "object",
      "required": [
        "canonical_url",
        "published",
        "observed_at",
        "source_time_kind",
        "lane",
        "universe_tickers",
        "score_components",
        "provider",
        "publisher",
        "publisher_domain",
        "source_class",
        "source_record_id",
        "tickers",
        "summary",
        "duplicate_providers",
        "duplicate_publishers",
        "source"
      ],
      "properties": {
        "link": {"$ref": "#/$defs/currentWebUrl"},
        "canonical_url": {"$ref": "#/$defs/currentWebUrl"},
        "published": {"type": ["string", "null"]},
        "as_of": {"$ref": "#/$defs/currentDateTime"},
        "observed_at": {"$ref": "#/$defs/currentDateTime"},
        "source_time_kind": {
          "enum": ["published", "event_time", "provider_seen"]
        },
        "provider": {"type": "string", "minLength": 1},
        "publisher": {"type": ["string", "null"]},
        "publisher_domain": {"type": ["string", "null"]},
        "source_class": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "tickers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "summary": {"type": ["string", "null"]},
        "duplicate_providers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "duplicate_publishers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"$ref": "#/$defs/headline"},
        {"$ref": "#/$defs/laneIntegrity"}
      ]
    },
    "currentDroppedHeadline": {
      "type": "object",
      "required": [
        "text",
        "title",
        "link",
        "canonical_url",
        "published",
        "as_of",
        "observed_at",
        "source_time_kind",
        "relevance",
        "reason",
        "lane",
        "universe_tickers",
        "score_components",
        "provider",
        "publisher",
        "publisher_domain",
        "source_class",
        "source_record_id",
        "tickers",
        "summary",
        "duplicate_providers",
        "duplicate_publishers",
        "kept_source_record_id"
      ],
      "properties": {
        "text": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "link": {"$ref": "#/$defs/currentWebUrl"},
        "canonical_url": {"$ref": "#/$defs/currentWebUrl"},
        "published": {"type": ["string", "null"]},
        "as_of": {"$ref": "#/$defs/currentDateTime"},
        "observed_at": {"$ref": "#/$defs/currentDateTime"},
        "source_time_kind": {
          "enum": ["published", "event_time", "provider_seen"]
        },
        "relevance": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1},
        "lane": {"enum": [null, "universe", "macro", "discovery"]},
        "universe_tickers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "score_components": {"$ref": "#/$defs/scoreComponents"},
        "provider": {"type": "string", "minLength": 1},
        "publisher": {"type": ["string", "null"]},
        "publisher_domain": {"type": ["string", "null"]},
        "source_class": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "tickers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "summary": {"type": ["string", "null"]},
        "duplicate_providers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "duplicate_publishers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "kept_source_record_id": {"type": ["string", "null"]}
      },
      "allOf": [
        {"$ref": "#/$defs/laneIntegrity"}
      ],
      "additionalProperties": false
    },
    "headline": {
      "type": "object",
      "required": [
        "text",
        "title",
        "link",
        "as_of",
        "relevance",
        "record_id"
      ],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "link": {"type": ["string", "null"], "format": "uri"},
        "as_of": {"type": "string", "format": "date-time"},
        "relevance": {"type": "integer", "minimum": 0},
        "lane": {"enum": ["universe", "macro", "discovery"]},
        "universe_tickers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "score_components": {"$ref": "#/$defs/scoreComponents"},
        "provider": {"type": ["string", "null"]},
        "publisher": {"type": ["string", "null"]},
        "publisher_domain": {"type": ["string", "null"]},
        "source_class": {"type": ["string", "null"]},
        "source_record_id": {"type": ["string", "null"]},
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["lane"]},
              {"required": ["universe_tickers"]},
              {"required": ["score_components"]}
            ]
          },
          "then": {
            "required": [
              "lane",
              "universe_tickers",
              "score_components"
            ],
            "allOf": [
              {"$ref": "#/$defs/laneIntegrity"}
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
